# Copy this file to .env.local and fill in the values for whichever AI
# provider(s) you want to use. EduHelp picks the first one with a key, in this
# priority order: AI_PROVIDER override -> OpenAI -> Anthropic -> OpenRouter ->
# Ollama Cloud. Without any keys it still runs on the deterministic CO/CA
# rules engine.

# Optional: hard-pin a provider. One of: openai | anthropic | openrouter | ollama
AI_PROVIDER=

# ─── OpenAI (Chat Completions / Responses) ───────────────────────────────────
# Docs:  https://developers.openai.com/api/docs/models
# Frontier:    gpt-5.5            (default · 1M ctx)
# Mid-tier:    gpt-5.4-mini       (cheap, fast, 1M ctx)
# Tiny:        gpt-5.4-nano       (fastest, 400K ctx)
# Legacy:      gpt-4.1, gpt-4.1-mini, gpt-4o, gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ─── Anthropic (Messages API) ─────────────────────────────────────────────────
# Docs:  https://docs.anthropic.com/en/docs/about-claude/models/all-models
# Most capable: claude-opus-4-7    (agentic coding, 1M ctx)
# Balanced:     claude-sonnet-4-6  (default · 1M ctx)
# Fastest:      claude-haiku-4-5   (200K ctx)
# Legacy:       claude-opus-4-6, claude-sonnet-4-5, claude-opus-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Keys:   https://openrouter.ai/keys
# Models: https://openrouter.ai/models
# Curated picks for EduHelp:
#   anthropic/claude-sonnet-4.6    (default)
#   anthropic/claude-opus-4.7
#   ~anthropic/claude-sonnet-latest   (always-latest alias)
#   openai/gpt-5.5
#   openai/gpt-5.4-mini
#   google/gemini-3-flash-preview
#   z-ai/glm-5.1
#   deepseek/deepseek-v4-pro
#   moonshotai/kimi-k2.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_SITE_URL=https://eduhelp.app

# ─── Ollama Cloud (remote API on ollama.com) ──────────────────────────────────
# Docs:    https://docs.ollama.com/cloud
# Catalog: https://ollama.com/search?c=cloud
#
# 1. Create an API key:  https://ollama.com/settings/keys
# 2. List the exact tags your account can use:
#      curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
# 3. Set OLLAMA_MODEL to one of those tags. Cloud catalog families:
#      kimi-k2.6, glm-5.1, deepseek-v4-flash, deepseek-v4-pro, gemma4,
#      qwen3.5, qwen3-coder-next, ministral-3, devstral-small-2,
#      nemotron-3-super, qwen3-next, rnj-1, kimi-k2.5, nemotron-3-nano,
#      minimax-m2.7, glm-5, minimax-m2.5, devstral-2,
#      gemini-3-flash-preview, cogito-2.1, gpt-oss
#
# Remote API uses tags like `gpt-oss:120b`. Local CLI cloud-offload uses
# `gpt-oss:120b-cloud` style tags. EduHelp talks to the remote API.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=https://ollama.com/api

# ─── Misc ────────────────────────────────────────────────────────────────────
ENABLE_WEB_SCRAPING=true
